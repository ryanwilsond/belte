                    result.stind_ref++;
                    result.indirectAssignments++;
                    break;
                case "stloc":
                    result.stloc++;
                    result.localAssignments++;
                    break;
                case "stloc.0":
                    result.stloc_0++;
                    result.localAssignments++;
                    break;
                case "stloc.1":
                    result.stloc_1++;
                    result.localAssignments++;
                    break;
                case "stloc.2":
                    result.stloc_2++;
                    result.localAssignments++;
                    break;
                case "stloc.3":
                    result.stloc_3++;
                    result.localAssignments++;
                    break;
                case "stloc.s":
                    result.stloc_s++;
                    result.localAssignments++;
                    break;
                case "stobj":
                    result.stobj++;
                    result.indirectAssignments++;
                    break;
                case "stsfld":
                    result.stsfld++;
                    result.fieldAssignments++;
                    break;
                case "sub":
                    result.sub++;
                    break;
                case "sub.ovf":
                    result.sub_ovf++;
                    break;
                case "sub.ovf.un":
                    result.sub_ovf_un++;
                    break;
                case "switch":
                    result.@switch++;
                    break;
                case "tail":
                    result.tail++;
                    break;
                case "throw":
                    result.@throw++;
                    break;
                case "unaligned":
                    result.unaligned++;
                    break;
                case "unbox":
                    result.unbox++;
                    break;
                case "unbox.any":
                    result.unbox_any++;
                    break;
                case "volatile.":
                    result.volatile_++;
                    break;
                case "xor":
                    result.xor++;
                    break;
                default:
                    throw new System.Exception(f"Unexpected operand name '{instruction.get_OpCode().get_Name()!}'");
            }
        }
    }
}

