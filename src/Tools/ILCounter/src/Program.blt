    instructionResults.AppendLine(f"\tstind.i8: {result.stind_i8}");
    instructionResults.AppendLine(f"\tstind.r4: {result.stind_r4}");
    instructionResults.AppendLine(f"\tstind.r8: {result.stind_r8}");
    instructionResults.AppendLine(f"\tstind.ref: {result.stind_ref}");
    instructionResults.AppendLine(f"\tstloc: {result.stloc}");
    instructionResults.AppendLine(f"\tstloc.0: {result.stloc_0}");
    instructionResults.AppendLine(f"\tstloc.1: {result.stloc_1}");
    instructionResults.AppendLine(f"\tstloc.2: {result.stloc_2}");
    instructionResults.AppendLine(f"\tstloc.3: {result.stloc_3}");
    instructionResults.AppendLine(f"\tstloc.s: {result.stloc_s}");
    instructionResults.AppendLine(f"\tstobj: {result.stobj}");
    instructionResults.AppendLine(f"\tstsfld: {result.stsfld}");
    instructionResults.AppendLine(f"\tsub: {result.sub}");
    instructionResults.AppendLine(f"\tsub.ovf: {result.sub_ovf}");
    instructionResults.AppendLine(f"\tsub.ovf.un: {result.sub_ovf_un}");
    instructionResults.AppendLine(f"\tswitch: {result.@switch}");
    instructionResults.AppendLine(f"\ttail: {result.tail}");
    instructionResults.AppendLine(f"\tthrow: {result.@throw}");
    instructionResults.AppendLine(f"\tunaligned: {result.unaligned}");
    instructionResults.AppendLine(f"\tunbox: {result.unbox}");
    instructionResults.AppendLine(f"\tunbox.any: {result.unbox_any}");
    instructionResults.AppendLine(f"\tvolatile.: {result.volatile_}");
    instructionResults.AppendLine(f"\txor: {result.xor}");
    instructionResults.AppendLine();
    instructionResults.AppendLine(f"\tTotal: {Total}");

    string? content = instructionResults.ToString();

    scoped var stream = System.IO.File.Create("Results.txt");
    scoped var writer = new System.IO.StreamWriter(stream);

    writer.WriteLine(content);
}
