void CountMethod(MethodDefinition method, ref CountingResult result) {
    if (method.get_Body() -> body!) {
        var instructions = body.get_Instructions()!;

        for (var i = 0; i < instructions.get_Count(); i++) {
            var instruction = instructions.get_Item((int32)i)!;

            // We only have every instruction here to make sure we didn't miss any we care about
            switch (instruction.get_OpCode().get_Name()!) {
                case "add":
                    result.add++;
                    break;
                case "add.ovf":
                    result.add_ovf++;
                    break;
                case "add.ovf.un":
                    result.add_ovf_un++;
                    break;
                case "and":
                    result.and++;
                    break;
                case "arglist":
                    result.arglist++;
                    break;
                case "beq":
                    result.beq++;
                    break;
                case "beq.s":
                    result.beq_s++;
                    break;
                case "bge":
                    result.bge++;
                    break;
                case "bge.s":
                    result.bge_s++;
                    break;
                case "bge.un":
                    result.bge_un++;
                    break;
                case "bge.un.s":
                    result.bge_un_s++;
                    break;
                case "bgt":
                    result.bgt++;
                    break;
                case "bgt.s":
                    result.bgt_s++;
                    break;
                case "bgt.un":
                    result.bgt_un++;
                    break;
                case "bgt.un.s":
                    result.bgt_un_s++;
                    break;
                case "ble":
                    result.ble++;
                    break;
                case "ble.s":
                    result.ble_s++;
                    break;
                case "ble.un":
                    result.ble_un++;
                    break;
                case "ble.un.s":
