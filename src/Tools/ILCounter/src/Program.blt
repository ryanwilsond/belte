using System.Diagnostics;
using Mono.Cecil;

void Main(string[] args) {
    constexpr Path = "../../../bin/release/Compiler.dll";

    Debug.Assert(System.IO.File.Exists(Path));

    var assembly = AssemblyDefinition.ReadAssembly(Path)!;

    var types = assembly.MainModule!.Types!;

    Console.Clear();

    var result = new CountingResult();

    for (var i = 0; i < types.Count; i++) {
        var type = types.get_Item((int32)i)!;

        Console.Clear();
        Console.SetCursorPosition(0, 0);
        Console.Print("Counting ");
        Console.Print((string)type.FullName!);
        Console.PrintLine(" ...");

        var methods = type.Methods!;

        for (var j = 0; j < methods.Count; j++) {
            var method = methods.get_Item((int32)j)!;
            CountMethod(method, ref result);
        }
    }

    var total = result.localAssignments +
                result.parameterAssignments +
                result.fieldAssignments +
                result.arrayAssignments +
                result.indirectAssignments +
                result.otherAssignments;

    Console.Clear();

    Console.PrintLine("Assignment Results:");
    Console.PrintLine(f"\tLocal Assignments: {result.localAssignments}");
    Console.PrintLine(f"\tParameter Assignments: {result.parameterAssignments}");
    Console.PrintLine(f"\tField Assignments: {result.fieldAssignments}");
    Console.PrintLine(f"\tArray Assignments: {result.arrayAssignments}");
    Console.PrintLine(f"\tIndirect (ref) Assignments: {result.indirectAssignments}");
    Console.PrintLine(f"\tOther: {result.otherAssignments}");
    Console.PrintLine();
    Console.PrintLine(f"\tTotal: {total}");

    WriteResults(ref result);
}

