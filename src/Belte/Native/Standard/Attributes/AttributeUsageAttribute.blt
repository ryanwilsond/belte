
namespace System;

[AttributeUsage(AttributeTargets.All)]
public sealed class AttributeUsageAttribute extends Attribute {
    public constructor(AttributeTargets attributeTargets) { }

    public constructor(AttributeTargets attributeTargets, bool AllowMultiple = false, bool Inherited = true) { }
}

public enum flags AttributeTargets extends int32 {
    Assembly = 1 << 0,
    Module = 1 << 1,
    Class = 1 << 2,
    Struct = 1 << 3,
    Enum = 1 << 4,
    Constructor = 1 << 5,
    Method = 1 << 6,
    Field = 1 << 8,
    Interface = 1 << 10,
    Parameter = 1 << 11,
    ReturnValue = 1 << 13,
    TemplateParameter = 1 << 14,

    All = (1 << 15) - 1,
}
