/*

    Pong

    This program uses the built-in graphics library to make an intractable, 2D pong game.

    Based on AstroSam's implementation: https://github.com/sam-astro/Z-Sharp/tree/master/examples/Pong-Example-Project

*/

// Many graphics types are included in the Belte.Graphics namespace
// These types include: Vec2, Sprite, Text
using Belte.Graphics;

// When `Main` is present in a non-static class, a single instance of that class is automatically created and managed
// by the compiler, allowing you to modify and access instance data.
class Program;

Vec2 centerOfScreen;
Vec2 ballPosition;
Vec2 lPaddleTargetPosition;
Vec2 rPaddleTargetPosition;
Vec2 ballVelocity;

Sprite ball;
Sprite lPaddle;
Sprite rPaddle;
Sprite net;
Text scoreOne;
Text scoreTwo;
Text info;

bool aiOn = true;
bool previousEnter = false;

void Main() {
    // `Graphics.Initialize` creates the window and must be the first Graphics call made
    Graphics.Initialize("Pong", Settings.ScreenWidth, Settings.ScreenHeight);
    Graphics.LockFramerate(120);

    centerOfScreen = new Vec2(Settings.ScreenWidth / 2.0, Settings.ScreenHeight / 2.0);

    final ballScale = new Vec2(10, 10);
    ballPosition = centerOfScreen.Copy();

    final paddleScale = new Vec2(4, 70);
    const yPosPaddle = centerOfScreen.y;

    final lPaddlePosition = new Vec2(15, yPosPaddle);
    lPaddleTargetPosition = new Vec2(15, yPosPaddle);

    constexpr rOffset = Settings.ScreenWidth - 15;
    final rPaddlePosition = new Vec2(rOffset, yPosPaddle);
    rPaddleTargetPosition = new Vec2(rOffset, yPosPaddle);

    final netScale = new Vec2(3, Settings.ScreenHeight)!;

    // `Graphics.LoadSprite` loads an image file with a position, size, and rotation
    ball = Graphics.LoadSprite("samples/Pong/Assets/ball.png", ballPosition, ballScale, 0);
    lPaddle = Graphics.LoadSprite("samples/Pong/Assets/square.png", lPaddlePosition, paddleScale, 0);
    rPaddle = Graphics.LoadSprite("samples/Pong/Assets/square.png", rPaddlePosition, paddleScale, 0);
    net = Graphics.LoadSprite("samples/Pong/Assets/net.png", centerOfScreen, netScale, 0);

    constexpr leftOffset = Settings.ScreenWidth / 4;
    final scoreOnePosition = new Vec2(leftOffset, 40);
    scoreOne = Graphics.LoadText("0", "samples/Pong/Assets/arial.ttf", scoreOnePosition, 60, 0, 255, 255, 255);

    constexpr rightOffset = Settings.ScreenWidth - Settings.ScreenWidth / 4;
    final scoreTwoPosition = new Vec2(rightOffset, 40);
    // `Graphics.LoadText` renders a string using a given font, position, font size, angle, and color values
    scoreTwo = Graphics.LoadText("0", "samples/Pong/Assets/arial.ttf", scoreTwoPosition, 60, 0, 255, 255, 255);

    final infoPosition = new Vec2(centerOfScreen.x, Settings.ScreenHeight - 60);
    info = Graphics.LoadText(
        "Use 'W' and 'S' or 'UP' and 'DOWN' arrows to control or press 'ENTER' to toggle AI",
        "samples/Pong/Assets/arial.ttf",
        infoPosition,
        15, 0, 255, 255, 255
    );

    ballVelocity = new Vec2(Settings.BallSpeed, Settings.BallSpeed);
}

// `Update` is a special method that the program runs every frame after `Main` finishes
void Update(decimal deltaTime) {
    Graphics.Fill(0, 0, 0);

    if (Graphics.GetKey("W")) {
        var newY = lPaddleTargetPosition.y - Settings.PaddleSpeed * deltaTime;
        newY ><= [0 + lPaddle.dst.h / 2, Settings.ScreenHeight - lPaddle.dst.h / 2];
        lPaddleTargetPosition.y = newY;
    }

    if (Graphics.GetKey("S")) {
        var newY = lPaddleTargetPosition.y + Settings.PaddleSpeed * deltaTime;
        newY ><= [0 + lPaddle.dst.h / 2, Settings.ScreenHeight - lPaddle.dst.h / 2];
        lPaddleTargetPosition.y = newY;
    }

    const oldYl = lPaddle.position.y;
    const stopSpeedl = Settings.LerpSpeed * deltaTime;
    const newYl = lPaddleTargetPosition.y;
    const lerpedYl = Math.Lerp(oldYl, newYl, stopSpeedl);
    lPaddle.SetPosition(lPaddle.position.x, lerpedYl);

    if (aiOn) {
        if (rPaddle.position.y < ball.position.y) {
            var newY = rPaddleTargetPosition.y + Settings.PaddleSpeed * deltaTime;
            newY ><= [0 + rPaddle.dst.h / 2, Settings.ScreenHeight - rPaddle.dst.h / 2];
            rPaddleTargetPosition.y = newY;
        }

        if (rPaddle.position.y > ball.position.y) {
            var newY = rPaddleTargetPosition.y - Settings.PaddleSpeed * deltaTime;
            newY ><= [0 + rPaddle.dst.h / 2, Settings.ScreenHeight - rPaddle.dst.h / 2];
            rPaddleTargetPosition.y = newY;
        }
    } else {
        if (Graphics.GetKey("Up")) {
            var newY = rPaddleTargetPosition.y - Settings.PaddleSpeed * deltaTime;
            newY ><= [0 + rPaddle.dst.h / 2, Settings.ScreenHeight - rPaddle.dst.h / 2];
            rPaddleTargetPosition.y = newY;
        }

        if (Graphics.GetKey("Down")) {
            var newY = rPaddleTargetPosition.y + Settings.PaddleSpeed * deltaTime;
            newY ><= [0 + rPaddle.dst.h / 2, Settings.ScreenHeight - rPaddle.dst.h / 2];
            rPaddleTargetPosition.y = newY;
        }
    }

    const oldYr = rPaddle.position.y;
    const stopSpeedr = Settings.LerpSpeed * deltaTime;
    const newYr = rPaddleTargetPosition.y;
    const lerpedYr = Math.Lerp(oldYr, newYr, stopSpeedr);
    rPaddle.SetPosition(rPaddle.position.x, lerpedYr);

    // Checking previous state of Enter key to detect the edge
    // (toggles once per key press instead of constantly)
    if (Graphics.GetKey("Enter") && !previousEnter)
        aiOn = !aiOn;

    final scaledVelocity = ballVelocity.Copy();
    scaledVelocity.x *= deltaTime;
    scaledVelocity.y *= deltaTime;
    ball.SetPosition(ball.position.x + ballVelocity.x * deltaTime, ball.position.y + ballVelocity.y * deltaTime);

    Graphics.DrawSprite(ball);
    Graphics.DrawSprite(lPaddle);
    Graphics.DrawSprite(rPaddle);
    Graphics.DrawSprite(net);
    Graphics.DrawText(scoreOne);
    Graphics.DrawText(scoreTwo);
    Graphics.DrawText(info);

    HandleBallBounce();

    previousEnter = Graphics.GetKey("Enter");
}

private void HandleBallBounce() {
    const ballX = ball.position.x;
    const ballY = ball.position.y;
    const scaleY = ball.dst.h;

    const topEdge = ballY - scaleY / 2;
    const bottomEdge = ballY + scaleY / 2;

    if (topEdge <= 0 || bottomEdge >= Settings.ScreenHeight) {
        const vX = ballVelocity.x;
        var vY = ballVelocity.y;
        vY *= -1;
        ballVelocity = new Vec2(vX, vY);
        return;
    }

    if (ballX < 0) {
        final ballPos = centerOfScreen.Copy();
        ballPos.x -= ball.dst.w;
        ballPos.y -= ball.dst.h;
        ballPos.x -= Settings.ScreenWidth / 3;
        ball.SetPosition(ballPos.x, ballPos.y);
        ballVelocity = new Vec2(Settings.BallSpeed, 0);
        scoreTwo.text = (string!)(((int)scoreTwo.text) + 1);
    }

    if (ballX > Settings.ScreenWidth) {
        final ballPos = centerOfScreen.Copy();
        ballPos.x -= ball.dst.w;
        ballPos.y -= ball.dst.h;
        ballPos.x += Settings.ScreenWidth / 3;
        ball.SetPosition(ballPos.x, ballPos.y);
        ballVelocity = new Vec2(-Settings.BallSpeed, 0);
        scoreOne.text = (string!)(((int)scoreOne.text) + 1);
    }

    const collidingL = Colliding(ball.dst, lPaddle.dst);

    if (collidingL) {
        const difference = lPaddle.position.y - ballY;
        const paddleHeight = lPaddle.dst.h;
        const normRelIntersectY = difference / (paddleHeight / 2);
        const bounceAngle = normRelIntersectY * 0.523599;
        const ballVx = Settings.BallSpeed * Math.Cos(bounceAngle);
        const ballVy = Settings.BallSpeed * Math.Sin(bounceAngle) * -1;
        ballVelocity = new Vec2(ballVx, ballVy);
    }

    const collidingR = Colliding(ball.dst, rPaddle.dst);

    if (collidingR) {
        const difference = rPaddle.position.y - ballY;
        const paddleHeight = rPaddle.dst.h;
        const normRelIntersectY = difference / (paddleHeight / 2);
        const bounceAngle = normRelIntersectY * -0.523599;
        const ballVx = Settings.BallSpeed * Math.Cos(bounceAngle) * -1;
        const ballVy = Settings.BallSpeed * Math.Sin(bounceAngle);
        ballVelocity = new Vec2(ballVx, ballVy);
    }
}

private static bool Colliding(Rect a, Rect b) {
    const collisionX = a.x + a.w >= b.x && b.x + b.w >= a.x;
    const collisionY = a.y + a.h >= b.y && b.y + b.h >= a.y;
    return collisionX && collisionY;
}
